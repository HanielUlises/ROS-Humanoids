<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_model</name>
  <version>0.1.0</version>
  <description>Kinematic and inertial model of the Unitree G1, built from g1_description.</description>

  <maintainer email="hanielulises@gmail.com">Haniel</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>urdfdom</depend>
  <depend>urdfdom_headers</depend>
  <depend>orocos_kdl_vendor</depend>

  <exec_depend>g1_description</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
